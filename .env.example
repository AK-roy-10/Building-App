# --- Core ---
APP_ENV=dev
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./trading.db
# For production use: ******host:5432/dbname

# --- Auth ---
JWT_SECRET=change-me-too
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=1440

# --- Credential encryption (Fernet key, base64, 32 bytes). Generate with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENC_KEY=

# --- LLM (optional). If unset, a deterministic mock LLM is used. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Broker (optional, Alpaca paper). If unset, only built-in paper broker works. ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Stripe (optional; if unset, billing is mocked) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
